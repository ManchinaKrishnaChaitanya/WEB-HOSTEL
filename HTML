
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grand Palace Hotel</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <h2 class="logo">Grand Palace</h2>

            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#rooms">Rooms</a></li>
                <li><a href="#facilities">Facilities</a></li>
                <li><a href="#reviews">Reviews</a></li>
                <li><a href="#booking">Booking</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <h1>Experience Luxury & Comfort</h1>
            <p>Your perfect stay begins here. Relax, refresh and enjoy.</p>
            <a href="#rooms" class="btn">Explore Rooms</a>
        </div>
    </section>

    <!-- About Section -->
    <section class="about">
        <h2>Welcome to Grand Palace Hotel</h2>
        <p>
            Experience world-class hospitality, comfortable rooms,
            delicious food and excellent service. We make every stay
            special with luxury and comfort.
        </p>
    </section>

    <!-- Room Categories -->
    <section class="rooms" id="rooms">
        <h2>Our Room Categories</h2>
        <p class="section-description">
            Choose the perfect room for your stay.
        </p>

        <div class="room-container">

            <!-- Standard Room -->
            <div class="room-card">
                <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?w=800"
                     alt="Standard Room">

                <div class="room-info">
                    <h3>Standard Room</h3>
                    <p>Comfortable room with modern interiors and essential facilities.</p>
                    <h4>₹2,500 / Night</h4>
                    <a href="#booking" class="btn">Book Now</a>
                </div>
            </div>

            <!-- Deluxe Room -->
            <div class="room-card">
                <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?w=800"
                     alt="Deluxe Room">

                <div class="room-info">
                    <h3>Deluxe Room</h3>
                    <p>Spacious room with beautiful interiors and premium comfort.</p>
                    <h4>₹4,000 / Night</h4>
                    <a href="#booking" class="btn">Book Now</a>
                </div>
            </div>

            <!-- Luxury Suite -->
            <div class="room-card">
                <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800"
                     alt="Luxury Suite">

                <div class="room-info">
                    <h3>Luxury Suite</h3>
                    <p>Elegant suite with a living area and premium services.</p>
                    <h4>₹6,500 / Night</h4>
                    <a href="#booking" class="btn">Book Now</a>
                </div>
            </div>

            <!-- Family Room -->
            <div class="room-card">
                <img src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=800"
                     alt="Family Room">

                <div class="room-info">
                    <h3>Family Room</h3>
                    <p>Large and comfortable room suitable for family stays.</p>
                    <h4>₹5,500 / Night</h4>
                    <a href="#booking" class="btn">Book Now</a>
                </div>
            </div>

        </div>
    </section>

    <!-- Facilities -->
    <section class="facilities" id="facilities">
        <h2>Our Hotel Facilities</h2>

        <div class="facility-container">

            <div class="facility-card">
                <span>📶</span>
                <h3>Free Wi-Fi</h3>
                <p>High-speed internet access.</p>
            </div>

            <div class="facility-card">
                <span>🏊</span>
                <h3>Swimming Pool</h3>
                <p>Relax in our beautiful swimming pool.</p>
            </div>

            <div class="facility-card">
                <span>🍽️</span>
                <h3>Restaurant</h3>
                <p>Enjoy delicious food and beverages.</p>
            </div>

            <div class="facility-card">
                <span>🚗</span>
                <h3>Free Parking</h3>
                <p>Safe and secure vehicle parking.</p>
            </div>

            <div class="facility-card">
                <span>💪</span>
                <h3>Fitness Center</h3>
                <p>Stay active with our modern gym.</p>
            </div>

            <div class="facility-card">
                <span>🛎️</span>
                <h3>24/7 Service</h3>
                <p>Round-the-clock room assistance.</p>
            </div>

        </div>
    </section>

    <!-- Customer Reviews -->
    <section class="reviews" id="reviews">
        <h2>Customer Reviews</h2>

        <div class="review-container">

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"Excellent rooms and wonderful hospitality. Had a great stay!"</p>
                <h3>- Rahul</h3>
            </div>

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"Very clean rooms, delicious food and friendly staff."</p>
                <h3>- Priya</h3>
            </div>

            <div class="review-card">
                <div class="stars">★★★★☆</div>
                <p>"Beautiful hotel with amazing facilities. Highly recommended."</p>
                <h3>- Arjun</h3>
            </div>

        </div>
    </section>

    <!-- Booking Section -->
    <section class="booking" id="booking">
        <h2>Book Your Stay</h2>
        <p>Fill in your details to request a room reservation.</p>

        <form class="booking-form">

            <label for="name">Full Name</label>
            <input type="text" id="name"
                   placeholder="Enter your full name" required>

            <label for="email">Email Address</label>
            <input type="email" id="email"
                   placeholder="Enter your email" required>

            <label for="phone">Phone Number</label>
            <input type="tel" id="phone"
                   placeholder="Enter your phone number" required>

            <label for="room">Select Room</label>
            <select id="room" required>
                <option value="">Choose a room</option>
                <option>Standard Room - ₹2,500</option>
                <option>Deluxe Room - ₹4,000</option>
                <option>Luxury Suite - ₹6,500</option>
                <option>Family Room - ₹5,500</option>
            </select>

            <label for="checkin">Check-in Date</label>
            <input type="date" id="checkin" required>

            <label for="checkout">Check-out Date</label>
            <input type="date" id="checkout" required>

            <label for="guests">Number of Guests</label>
            <input type="number" id="guests"
                   min="1" max="10" placeholder="Number of guests" required>

            <button type="submit">Submit Booking Request</button>

        </form>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <div class="contact-container">

            <div>
                <h3>📍 Address</h3>
                <p>Hyderabad, Telangana, India</p>
            </div>

            <div>
                <h3>📞 Phone</h3>
                <p>+91 98765 43210</p>
            </div>

            <div>
                <h3>✉ Email</h3>
                <p>grandpalace@example.com</p>
            </div>

        </div>

        <iframe
            src="https://www.google.com/maps?q=Hyderabad%2C%20Telangana&output=embed"
            width="100%"
            height="300"
            style="border:0;"
            loading="lazy">
        </iframe>
    </section>

    <!-- Footer -->
    <footer>
        <h2>Grand Palace Hotel</h2>
        <p>Luxury, Comfort and Hospitality.</p>
        <p>© 2026 Grand Palace Hotel. All Rights Reserved.</p>
    </footer>

</body>
</html>
